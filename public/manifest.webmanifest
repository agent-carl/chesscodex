{
    "name": "Chess Codex",
    "short_name": "Codex",
    "description": "Interactive encyclopaedia of chess openings — 3,690 indexed lines with statistics and engine play.",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "orientation": "any",
    "background_color": "#faf7f0",
    "theme_color": "#2a5d8f",
    "lang": "en",
    "categories": ["education", "games", "reference"],
    "icons": [
        { "src": "/public/favicon.svg", "sizes": "any",     "type": "image/svg+xml", "purpose": "any maskable" },
        { "src": "/public/favicon.svg", "sizes": "192x192", "type": "image/svg+xml" },
        { "src": "/public/favicon.svg", "sizes": "512x512", "type": "image/svg+xml" }
    ],
    "shortcuts": [
        { "name": "Search openings", "url": "/search",   "description": "Find an opening by moves or name" },
        { "name": "All openings A-Z","url": "/openings", "description": "Browse the full alphabetical index" },
        { "name": "Random",          "url": "/random",   "description": "Jump to a random opening" }
    ]
}
