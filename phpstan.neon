parameters:
    level: 8
    paths:
        - lib
        - templates
        - tests
        - tools
        - index.php
        - og.php
        - prewarm.php
        - config.example.php

services:
    -
        class: PdoStatementReturnType
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
    -
        class: PdoFetchAllReturnType
        tags: [phpstan.broker.dynamicMethodReturnTypeExtension]
    -
        class: ImageColorAllocateReturnType
        tags: [phpstan.broker.dynamicFunctionReturnTypeExtension]
    -
        class: CacheRememberReturnType
        tags: [phpstan.broker.dynamicStaticMethodReturnTypeExtension]
