{
    "name": "ifrutella/chesscodex",
    "description": "Free, ad-free encyclopedia of every named chess opening.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.3",
        "erusev/parsedown": "~1.7.4",
        "p-chess/chess": "^1.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-0": {
            "": "lib/"
        },
        "files": [
            "lib/db.php",
            "lib/parser.php",
            "lib/strings.php"
        ]
    },
    "config": {
        "vendor-dir": "_composer_vendor",
        "platform": {
            "php": "8.3"
        },
        "preferred-install": "dist",
        "sort-packages": true
    }
}
