# Pretty URLs: anything that isn't an actual file or directory hits index.php.
# /openings/<slug> → index.php?path=/openings/<slug>
RewriteEngine On

# If the project is mounted in a subfolder (e.g. /chess-codex/), uncomment the
# next line and set it to that subfolder, so RewriteRule's "^" anchor works.
# RewriteBase /chess-codex/

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# Hide common backup/source files if anyone uploads them.
<FilesMatch "\.(sql|md|tsv|example\.php)$">
    Require all denied
</FilesMatch>

# Keep config.php from ever being served as a static file (defence in depth —
# Apache should already execute it as PHP, not serve raw).
<Files "config.php">
    Require all denied
</Files>

# Stockfish WebAssembly: ensure .wasm is served with the right MIME so the
# browser can use streaming compilation. Falls back gracefully if mod_mime
# is missing on this host.
<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType application/manifest+json .webmanifest
</IfModule>

# Gzip/Brotli on text responses. Cuts HTML/JSON/CSS payload ~70%. Apache on
# OVH ships with mod_deflate enabled; falls back gracefully if not.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
</IfModule>

# Long-cache static assets. Cache-bust via ?v=<filemtime> in <link>/<script>
# tags (see templates/layout.php) so updates show up immediately for users.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|wasm|svg|woff2|woff|png|jpg|jpeg|gif)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>

    # Let public/sw.js claim the whole origin as its scope (default scope is
    # only /public/, which would make caching almost useless).
    <Files "sw.js">
        Header set Service-Worker-Allowed "/"
        # SW file itself must not be long-cached, otherwise users get stuck
        # on the old service worker for a month.
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    </Files>

    # Defence-in-depth security headers. CSP intentionally omitted — too easy
    # to break with future feature additions; revisit when the surface stabilises.
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Frame-Options "SAMEORIGIN"
    # (Permissions-Policy moved below alongside the cross-origin headers
    # for grouping; this older directive is intentionally a no-op.)

    # HSTS — once site is reliably HTTPS, force browsers to remember for 1 year.
    # Set "always" so it's emitted even on error responses.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # HTTP/2 server-push hints — emitted on HTML responses so the browser
    # starts fetching style.min.css before parsing <head>. Modern browsers
    # treat `Link: rel=preload` as a strong hint even without H/2.
    <FilesMatch "\.(php|html)$">
        Header add Link "</public/style.min.css>; rel=preload; as=style"
        Header add Link "</public/favicon.svg>; rel=preload; as=image; type=image/svg+xml"
    </FilesMatch>

    # Cross-Origin policies — modern browser hardening. COOP isolates the
    # browsing context (no SharedArrayBuffer leak to embedders); CORP
    # asserts our resources can only be loaded by same-origin pages.
    # COEP is intentionally NOT set — would break Lichess image fetches.
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Resource-Policy "same-origin"

    # Permissions-Policy — opt out of features we don't need + the new
    # interest-cohort tracking (FLoC successor) so we never participate.
    Header set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=(), browsing-topics=()"

    # CSP — narrow attack surface. 'unsafe-inline' is needed for our two
    # inline scripts (theme init + toggle/SW register); migrating those to
    # an external file would let us drop it. 'wasm-unsafe-eval' is the
    # narrow sibling of 'unsafe-eval' that just allows WebAssembly compile
    # (Stockfish needs it).
    Header set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; worker-src 'self'; frame-ancestors 'self'; form-action 'self'; base-uri 'self'"
</IfModule>
